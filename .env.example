# Optional host-native frontend overrides. Copy to frontend/.env if needed.
# Defaults already match the split development servers.

# Same-origin API path used by the browser. Do not point this at another origin.
VITE_API_BASE_URL=/api/v1

# Vite dev/preview proxy target for /api.
VITE_DEV_API_TARGET=http://localhost:3000

# Use / for `pnpm dev`; production Docker builds set /app/ explicitly.
VITE_PUBLIC_BASE=/

VITE_LANDING_URL=http://localhost:4321
VITE_SUPPORT_EMAIL=
VITE_APP_ENV=development
